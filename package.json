    "test:all": "npm run test:unit",
    "test:scoring": "tsx scripts/test-scoring.ts",
    "test:zoom": "tsx scripts/test-zoom.ts",
    "test:picture-finish": "tsx scripts/test-picture-finish.ts",
    "test:image-crop": "tsx scripts/test-image-crop.ts",
    "test:audio-speed": "tsx scripts/test-audio-speed.ts",
    "test:audio-reverse": "tsx scripts/test-audio-reverse.ts",
    "test:text-reveal": "tsx scripts/test-text-reveal.ts",
    "test:display-name": "tsx scripts/test-display-name.ts",
    "test:game-pack": "tsx scripts/test-game-pack.ts",
    "test:rounds": "tsx scripts/test-rounds.ts",
    "test:night-recap": "tsx scripts/test-night-recap.ts",
    "test:bans": "tsx scripts/test-bans.ts",
    "test:question-bank": "tsx scripts/test-question-bank.ts",
    "test:recovery": "tsx scripts/test-recovery.ts",
    "test:byte-range": "tsx scripts/test-byte-range.ts",
    "test:session": "tsx scripts/test-session.ts",
    "test:choice-counts": "tsx scripts/test-choice-counts.ts",
    "test:teams": "tsx scripts/test-teams.ts",
    "test:fuzzy": "tsx scripts/test-fuzzy-answer.ts",
    "test:closest": "tsx scripts/test-closest-wager.ts",
    "test:score-race": "tsx scripts/test-score-race.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
