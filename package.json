{
  "name": "trivia-live",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy",
