DATABASE_URL=postgresql://trivia:trivia@localhost:5432/trivia_live?schema=public
# First install: open /admin. In production you MUST set SETUP_TOKEN and enter it on the form.
SETUP_TOKEN=
# Optional headless bootstrap (skips the setup form):
# SUPERADMIN_BOOTSTRAP=1
SUPERADMIN_EMAIL=admin@localhost
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Super Admin
# Required in production (24+ random characters)
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
HOST=0.0.0.0
PORT=3000
NEXT_PUBLIC_SOCKET_URL=
# NEXT_PUBLIC_PUBLIC_URL=http://192.168.1.20:3000
