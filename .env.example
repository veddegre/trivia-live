# Postgres (Compose builds DATABASE_URL from these)
POSTGRES_USER=trivia
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=trivia_live
DATABASE_URL=postgresql://trivia:change-me-db-password@localhost:5432/trivia_live?schema=public

# Sessions — required in production (24+ random characters)
SESSION_SECRET=change-me-to-a-long-random-string

# First-time admin (pick ONE approach)
# A) Setup form at /admin — set SETUP_TOKEN and enter it on the form
SETUP_TOKEN=
# B) Headless bootstrap once, then set SUPERADMIN_BOOTSTRAP=0
SUPERADMIN_BOOTSTRAP=0
SUPERADMIN_EMAIL=admin@localhost
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Super Admin

# Public HTTPS origin (Cloudflare hostname) for host QR / join URLs
NEXT_PUBLIC_PUBLIC_URL=https://trivia.example.com

# Secure cookies (1 behind HTTPS / Cloudflare)
COOKIE_SECURE=1

HOST=0.0.0.0
PORT=3000
NEXT_PUBLIC_SOCKET_URL=
