DATABASE_URL=postgresql://trivia:trivia@localhost:5432/trivia_live?schema=public
# Bootstrap super-admin (created on first login / seed)
SUPERADMIN_EMAIL=admin@localhost
SUPERADMIN_PASSWORD=change-me
SUPERADMIN_NAME=Super Admin
# Used to sign session cookies (defaults to SUPERADMIN_PASSWORD)
SESSION_SECRET=change-me-too
# Legacy fallback for SUPERADMIN_PASSWORD if unset
ADMIN_PASSWORD=change-me
HOST=0.0.0.0
PORT=3000
# Leave empty when the UI and Socket.io share the same origin
NEXT_PUBLIC_SOCKET_URL=
# Absolute site origin for host-screen QR codes (use your LAN IP when testing on phones)
# NEXT_PUBLIC_PUBLIC_URL=http://192.168.1.20:3000
