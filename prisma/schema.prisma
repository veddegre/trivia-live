generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  DRAFT
  LOBBY
  QUESTION
  REVEAL
  BETWEEN
  FINISHED
}

enum GameType {
  TRIVIA
  IMAGE_ZOOM
  AUDIO_SPEED
}

enum UserRole {
  HOST
  SUPERADMIN
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole     @default(HOST)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  games        Game[]
  results      GameResult[]
}

model Game {
  id                   String       @id @default(cuid())
  title                String
  code                 String       @unique
  status               GameStatus   @default(DRAFT)
  gameType             GameType     @default(TRIVIA)
  currentQuestionIndex Int          @default(0)
  questionOpenedAt     DateTime?
  hostToken            String       @unique @default(cuid())
  /** When false, players can only join while status is LOBBY */
  allowLateJoin        Boolean      @default(true)
  ownerId              String?
  owner                User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  questions            Question[]
  players              Player[]
  results              GameResult[]

  @@index([ownerId])
}

/** Survives Play again / player wipe — hall of fame for past nights. */
model GameResult {
  id          String   @id @default(cuid())
  gameId      String?
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  gameTitle   String
  joinCode    String
  winnerName  String
  winnerScore Int
  playerCount Int
  /** Top 3: [{ name, totalScore }] */
  podium      Json?
  finishedAt  DateTime @default(now())

  @@unique([gameId, joinCode])
  @@index([finishedAt])
  @@index([ownerId])
}

model Question {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  order         Int
  prompt        String
  options       String[]
  correctIndex  Int
  timeLimitSec  Int      @default(30)
  basePoints    Int      @default(500)
  timeBonus     Int      @default(500)
  /** Stored filename in UPLOAD_DIR; public URL is /api/media/{imageKey} */
  imageKey      String?
  /** Starting CSS scale for IMAGE_ZOOM (eases to 1 as the timer runs down) */
  startZoom     Int      @default(10)
  /** Stored filename in UPLOAD_DIR; public URL is /api/media/{audioKey} */
  audioKey      String?
  /** Starting HTMLAudioElement.playbackRate for AUDIO_SPEED (eases to 1) */
  startSpeed    Float    @default(2)
  answers       Answer[]

  @@unique([gameId, order])
}

model Player {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name       String
  token      String   @unique @default(cuid())
  totalScore Int      @default(0)
  createdAt  DateTime @default(now())
  answers    Answer[]

  @@unique([gameId, name])
}

model Answer {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceIndex Int
  answeredAt  DateTime @default(now())
  points      Int      @default(0)
  isCorrect   Boolean  @default(false)

  @@unique([playerId, questionId])
}
