generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GameStatus {
  DRAFT
  LOBBY
  QUESTION
  REVEAL
  BETWEEN
  FINISHED
}

enum GameType {
  TRIVIA
  IMAGE_ZOOM
  AUDIO_SPEED
  PICTURE_FINISH
  AUDIO_REVERSE
  UNSCRAMBLE
  FINISH_LINE
  SILHOUETTE
}

enum UserRole {
  HOST
  SUPERADMIN
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  /** Bumped on logout and password change so older cookies stop working. */
  sessionVersion Int        @default(0)
  role         UserRole     @default(HOST)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  games        Game[]
  results      GameResult[]
  banks        QuestionBank[]
}

model Game {
  id                   String       @id @default(cuid())
  title                String
  code                 String       @unique
  status               GameStatus   @default(DRAFT)
  gameType             GameType     @default(TRIVIA)
  currentQuestionIndex Int          @default(0)
  questionOpenedAt     DateTime?
  /** Set while the host has paused this question. Cleared on resume. */
  questionPausedAt     DateTime?
  /** Milliseconds added with +10s. The question's own limit stays unchanged. */
  questionExtraMs      Int          @default(0)
  hostToken            String       @unique @default(cuid())
  /** When false, players can only join while status is LOBBY */
  allowLateJoin        Boolean      @default(true)
  /** When true, players may change their pick until lock; speed uses the latest tap. */
  allowAnswerChange    Boolean      @default(false)
  /** Players join a team. One answer and one score per team. */
  teamMode             Boolean      @default(false)
  /** Display names blocked from joining until Play again. */
  bannedNames          String[]     @default([])
  ownerId              String?
  owner                User?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  questions            Question[]
  players              Player[]
  teams                Team[]
  results              GameResult[]

  @@index([ownerId])
}

/** Survives Play again / player wipe — hall of fame for past nights. */
model GameResult {
  id          String   @id @default(cuid())
  gameId      String?
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  gameTitle   String
  joinCode    String
  winnerName  String
  winnerScore Int
  playerCount Int
  /** Top 3: [{ name, totalScore }] */
  podium      Json?
  /** Full night recap (standings + per-question answers). Survives Play again. */
  recap       Json?
  finishedAt  DateTime @default(now())

  @@unique([gameId, joinCode])
  @@index([finishedAt])
  @@index([ownerId])
}

model Question {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  order         Int
  gameType      GameType @default(TRIVIA)
  prompt        String
  options       String[]
  correctIndex  Int
  timeLimitSec  Int      @default(30)
  basePoints    Int      @default(500)
  timeBonus     Int      @default(500)
  /** DOUBLE = 2× points. LIGHTNING = no speed bonus (correct/wrong only). */
  bonus         String   @default("NONE")
  /** Stored filename in UPLOAD_DIR; public URL is /api/media/{imageKey} */
  imageKey      String?
  /** Starting CSS scale for IMAGE_ZOOM (eases to 1 as the timer runs down) */
  startZoom     Int      @default(10)
  /** Named round this question belongs to. Blank inherits the previous title. */
  roundTitle    String   @default("")
  /** Stored filename in UPLOAD_DIR; public URL is /api/media/{audioKey} */
  audioKey      String?
  /** Starting HTMLAudioElement.playbackRate for AUDIO_SPEED (eases to 1) */
  startSpeed    Float    @default(2)
  /** Phrase or quote revealed on the host screen for Unscramble and Finish the Line. */
  revealText    String   @default("")
  /** Players type an answer. Every option is accepted; correctIndex is the one shown on reveal. */
  typed         Boolean  @default(false)
  /** Players type a number. The closest guesses win when the question locks. */
  closest       Boolean  @default(false)
  /** Players bet up to their current score. No speed bonus. */
  wager         Boolean  @default(false)
  answers       Answer[]

  @@unique([gameId, order])
}

model Team {
  id      String   @id @default(cuid())
  gameId  String
  game    Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name    String
  /** Lowercased name so "The Dogs" and "the dogs" are one team. */
  nameKey String
  players Player[]

  @@unique([gameId, nameKey])
  @@index([gameId])
}

model Player {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  teamId     String?
  team       Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  name       String
  token      String   @unique @default(cuid())
  totalScore Int      @default(0)
  createdAt  DateTime @default(now())
  answers    Answer[]

  @@unique([gameId, name])
  @@index([teamId])
}

model Answer {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceIndex Int
  /** What the player typed. Empty for a multiple-choice tap. */
  text        String   @default("")
  /** Points bet on a wager question. 0 otherwise. */
  wager       Int      @default(0)
  answeredAt  DateTime @default(now())
  points      Int      @default(0)
  isCorrect   Boolean  @default(false)

  @@unique([playerId, questionId])
}

/** Per-host reusable trivia pool. Insert into a night as a named round. */
model QuestionBank {
  id        String         @id @default(cuid())
  title     String
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  questions BankQuestion[]

  @@index([ownerId])
}

model BankQuestion {
  id           String       @id @default(cuid())
  bankId       String
  bank         QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  order        Int
  prompt       String
  options      String[]
  correctIndex Int
  timeLimitSec Int          @default(30)
  basePoints   Int          @default(500)
  timeBonus    Int          @default(500)
  bonus        String       @default("NONE")

  @@unique([bankId, order])
}
